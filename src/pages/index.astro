---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Footer from '../components/Footer.astro';

const latestPosts = (await getCollection('blog', ({ data }) => !data.draft && !data.unlisted))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<BaseLayout title="Jordan Hornblow | Software Engineer">
  <Hero />
  <main class="mx-auto max-w-2xl px-6">
    <!-- Who am I? -->
    <section class="py-5">
      <h2 class="mb-6 text-2xl font-extrabold tracking-tight md:text-3xl">Who am I?</h2>
      <div class="space-y-4 text-base leading-relaxed text-brand-text">
        <p>
          Kia ora, I'm Jordan. I'm a New Zealand software engineer focused on building scalable
          web platforms, cloud infrastructure, and developer tooling.
        </p>
        <p>
          Over the past 15+ years I've worked across fintech, hospitality, legal tech, and
          startups. I've built APIs, distributed systems, deployment pipelines, and internal
          tooling. My background spans companies like Xero, me&u, and LawVu.
        </p>
        <p>
          Lately I've been focused on AI-assisted product development, reusable architecture
          patterns, and shipping smaller systems quickly without sacrificing long-term
          maintainability. A lot of my recent work sits at the intersection of infrastructure,
          automation, and product engineering.
        </p>
        <p>
          I like systems that are minimal, explicit, tenant-aware, and operationally predictable.
        </p>
        <p>
          Outside of client and product work I maintain a handful of open-source projects and
          experiments. One of those is <a href="https://reference-architecture.603.nz" target="_blank" rel="noopener noreferrer" class="font-semibold text-brand-accent hover:underline">Reference Architecture</a>,
          a production-ready scaffolding platform for bootstrapping modern applications and
          AI-assisted workflows. I also build smaller product experiments, including <a href="https://lushauraltreats.com/" target="_blank" rel="noopener noreferrer" class="font-semibold text-brand-accent hover:underline">Lush Aural
          Treats</a>, an AI-assisted music discovery platform.
        </p>
        <p>
          After years in Melbourne and Austin I returned home to Te Waipounamu, Aotearoa in 2024
          and got back on the tools.
        </p>
      </div>
    </section>

    <!-- What do I do? -->
    <section class="py-5">
      <h2 class="mb-6 text-2xl font-extrabold tracking-tight md:text-3xl">What do I do?</h2>
      <div class="space-y-4 text-base leading-relaxed text-brand-text">
        <p>
          I design and build systems that support real products in production.
        </p>
        <p>
          That includes backend architecture, cloud infrastructure, automation, multi-tenant
          applications, developer tooling, and AI-assisted workflows. I enjoy working close to the
          infrastructure layer, but I also care deeply about product shape, usability, and
          developer experience.
        </p>
        <p>
          A lot of my recent work has focused on reusable foundations for fast-moving teams and
          modern product development. The goal is to reduce friction, increase reliability, and
          make systems easier to evolve over time.
        </p>
        <p>
          I'm drawn to systems that stay understandable as they scale. Clear operational
          boundaries. Explicit infrastructure. Predictable deployment models. Simple runtime
          behaviour over unnecessary complexity.
        </p>
      </div>
    </section>

    <!-- Latest Writing -->
    <section class="py-5">
      <h2 class="mb-6 text-2xl font-extrabold tracking-tight md:text-3xl">Latest writing</h2>
      <ul class="space-y-3 text-base leading-relaxed text-brand-text">
        {latestPosts.map((post) => (
          <li>
            <a href={`/blog/${post.id.replace(/\.(md|mdx)$/, '')}`} class="inline-flex items-center gap-1 font-semibold text-brand-accent hover:underline">
              → {post.data.title}
            </a>
          </li>
        ))}
      </ul>
      <p class="pt-4">
        <a href="/blog" class="inline-flex items-center gap-1 font-semibold text-brand-accent hover:underline">
          View all posts
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </p>
    </section>

    <!-- Systems I Build -->
    <section class="py-5">
      <h2 class="mb-6 text-2xl font-extrabold tracking-tight md:text-3xl">Systems I build</h2>
      <div class="space-y-6 text-base leading-relaxed text-brand-text">
        <div>
          <h3 class="mb-1 font-semibold text-brand-accent">Scalable web platforms</h3>
          <p>Designing and evolving systems that handle real-world complexity, including multi-tenant architectures, integrations, and operational workflows.</p>
        </div>
        <div>
          <h3 class="mb-1 font-semibold text-brand-accent">Automation and developer infrastructure</h3>
          <p>Building tooling, pipelines, and infrastructure that reduce manual work and improve engineering velocity.</p>
        </div>
        <div>
          <h3 class="mb-1 font-semibold text-brand-accent">AI-assisted systems</h3>
          <p>Applying AI and automation to practical problems, product workflows, and intelligent tooling.</p>
        </div>
        <div>
          <h3 class="mb-1 font-semibold text-brand-accent">Integration platforms</h3>
          <p>Designing APIs and integration layers that allow systems to communicate reliably across organisations.</p>
        </div>
        <p class="pt-2">
          <a href="https://603.nz" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 font-semibold text-brand-accent hover:underline">
            Explore engineering projects
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </p>
      </div>
    </section>

    <!-- What does jch254 mean? -->
    <section class="py-5">
      <h2 class="mb-6 text-2xl font-extrabold tracking-tight md:text-3xl">What does jch254 mean?</h2>
      <div class="space-y-4 text-base leading-relaxed text-brand-text">
        <p>
          jch254 was my University of Canterbury login username. I've been using it across GitHub,
          domains, and the internet since 2009. At this point it's less of a username and more of
          an identity.
        </p>
      </div>
    </section>

    <!-- Anything else? -->
    <section class="pt-5 pb-10">
      <h2 class="mb-6 text-2xl font-extrabold tracking-tight md:text-3xl">Anything else?</h2>
      <div class="space-y-4 text-base leading-relaxed text-brand-text">
        <p>
          Music is a huge part of my life. I'm a musician, producer, and long-time vinyl
          collector. During the Melbourne COVID lockdowns I leaned hard into that passion, building
          a collection of more than 800 records that I catalogue through Discogs.
        </p>
        <p>
          I'm also an active contributor to open-source software. Beyond code, I enjoy photography
          and documenting what I'm building through my blog, project portfolio, and GitHub profile.
        </p>
        <p>
          Most importantly, I'm an advocate for suicide awareness and prevention, a cause deeply
          personal after losing an uncle and two close friends. It's a reminder that behind the
          code, projects, and systems, people and connection matter most.
        </p>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
