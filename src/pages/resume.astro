---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Footer from '../components/Footer.astro';
import { resume } from '../data/resume';
---

<BaseLayout title="Resume | Jordan Hornblow" description="Jordan Hornblow's resume. Principal Engineer at Contented with 15+ years building and scaling platforms across fintech, hospitality, legal tech, and applied AI.">
  <Hero compact />

  <main class="mx-auto max-w-2xl px-6 pb-16">
    <div class="mb-8 flex flex-wrap items-center justify-between gap-4">
      <h1 class="text-2xl font-extrabold tracking-tight md:text-3xl">Resume</h1>
      <a
        href="/resume.pdf"
        download="Jordan Hornblow - Resume.pdf"
        class="inline-flex items-center gap-2 rounded-full border border-brand-border px-5 py-2 text-sm font-semibold text-brand-text transition hover:border-brand-accent hover:text-white"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
        </svg>
        Download PDF
      </a>
    </div>

    <!-- Summary -->
    <section class="mb-10">
      {resume.summary.map((para, i) => (
        <p class:list={['text-base leading-relaxed text-brand-text', i > 0 && 'mt-4']}>{para}</p>
      ))}
    </section>

    <!-- Skills -->
    <section class="mb-10">
      <h2 class="mb-4 text-2xl font-bold tracking-tight">Skills</h2>
      <div class="space-y-2 text-sm text-brand-text">
        {resume.skills.map((skill) => (
          <p><span class="font-semibold text-white">{skill.label}:</span> {skill.items}</p>
        ))}
      </div>
    </section>

    <!-- Experience -->
    <section class="mb-10">
      <h2 class="mb-6 text-2xl font-bold tracking-tight">Experience</h2>
      <div class="space-y-8">
        {resume.experience.map((entry) => (
          <div class="relative border-l-2 border-brand-border pl-6">
            <div class:list={[
              'absolute -left-[9px] top-1 h-4 w-4 rounded-full border-2 bg-brand-bg',
              entry.muted ? 'border-brand-border' : 'border-brand-accent',
            ]}></div>
            <h3 class="text-lg font-bold text-white">{entry.role}</h3>
            <p class="text-sm font-medium text-brand-accent">
              {entry.org && (
                <>
                  {entry.orgUrl
                    ? <a href={entry.orgUrl} target="_blank" rel="noopener noreferrer" class="hover:underline">{entry.org}</a>
                    : entry.org}
                  {' · '}
                </>
              )}
              {entry.location} · {entry.dates}
            </p>
            {entry.bullets && (
              <ul class="mt-2 space-y-1.5 text-sm leading-relaxed text-brand-text list-disc pl-4">
                {entry.bullets.map((bullet) => <li>{bullet}</li>)}
              </ul>
            )}
            {entry.paragraph && (
              <p class="mt-2 text-sm leading-relaxed text-brand-text">{entry.paragraph}</p>
            )}
          </div>
        ))}
      </div>
    </section>

    <!-- Early Career -->
    <section class="mb-10">
      <h2 class="mb-6 text-2xl font-bold tracking-tight">Early Career Highlights</h2>
      <div class="space-y-3 text-sm leading-relaxed text-brand-text">
        {resume.earlyCareer.map((entry) => (
          <p><span class="font-semibold text-white">{entry.title}</span> {entry.description}</p>
        ))}
      </div>
    </section>

    <!-- Education -->
    <section class="mb-10">
      <h2 class="mb-6 text-2xl font-bold tracking-tight">Education</h2>
      <div class="relative border-l-2 border-brand-border pl-6">
        <div class="absolute -left-[9px] top-1 h-4 w-4 rounded-full border-2 border-brand-accent bg-brand-bg"></div>
        <h3 class="text-lg font-bold text-white">{resume.education.degree}</h3>
        <p class="text-sm font-medium text-brand-accent">{resume.education.org} · {resume.education.location} · {resume.education.dates}</p>
        <ul class="mt-2 space-y-1 text-sm leading-relaxed text-brand-text list-disc pl-4">
          {resume.education.bullets.map((bullet) => <li>{bullet}</li>)}
        </ul>
      </div>
    </section>

    <!-- Achievements -->
    <section class="mb-10">
      <h2 class="mb-4 text-2xl font-bold tracking-tight">Achievements &amp; Awards</h2>
      <ul class="space-y-1.5 text-sm leading-relaxed text-brand-text list-disc pl-4">
        {resume.achievements.map((achievement) => <li>{achievement}</li>)}
      </ul>
    </section>

    <!-- Contact -->
    <section class="flex flex-wrap gap-4">
      <a
        href={`mailto:${resume.email}`}
        class="inline-flex items-center gap-2 rounded-full bg-brand-accent px-6 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-accent-hover"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
        </svg>
        Get in touch
      </a>
      <a
        href={resume.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-full border border-brand-border px-6 py-2.5 text-sm font-semibold text-brand-text transition hover:border-brand-accent hover:text-white"
      >
        View on LinkedIn
      </a>
    </section>
  </main>

  <Footer />
</BaseLayout>
